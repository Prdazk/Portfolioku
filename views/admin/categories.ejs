<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kelola Categories</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/categories.css">
</head>
<body>

<div class="shell">

  <%- include('../partials/admin-sidebar', { active: 'categories' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <p class="eyebrow">Kelola Konten</p>
        <h1>Categories</h1>
        <p class="topbar-sub"><%= categories.length %> kategori tersedia untuk portfolio kamu.</p>
      </div>
      <button type="button" class="btn btn-primary" id="btnAddCategory">+ Tambah Kategori</button>
    </div>

    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <% if (categories.length === 0) { %>
      <div class="empty-state">
        <p>Belum ada kategori. Klik "Tambah Kategori" untuk mulai menambahkan.</p>
      </div>
    <% } else { %>
      <div class="category-grid">
        <% categories.forEach(function(cat) { %>
          <div class="category-card">
            <div class="category-info">
              <h3><%= cat.name %></h3>
              <p class="category-count"><%= cat.project_count %> project menggunakan kategori ini</p>
            </div>

            <div class="category-actions">
              <button type="button"
                      class="btn btn-sm btn-icon js-edit-category"
                      title="Edit"
                      aria-label="Edit"
                      data-id="<%= cat.id %>"
                      data-name="<%= cat.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                </svg>
              </button>

              <button type="button"
                      class="btn btn-sm btn-icon btn-danger js-delete-category"
                      title="Hapus"
                      aria-label="Hapus"
                      data-action="/admin/categories/<%= cat.id %>/delete"
                      data-name="<%= cat.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                </svg>
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

</div>

<!-- Modal Tambah / Edit Category -->
<div class="modal-overlay" id="categoryModalOverlay">
  <div class="modal-box modal-box-confirm">
    <button type="button" class="modal-close" id="categoryModalCloseBtn">&times;</button>
    <div class="modal-body">
      <h2 id="categoryModalTitle">Tambah Kategori</h2>
      <form id="categoryForm" method="POST" action="/admin/categories">
        <div class="form-group">
          <label for="name">Nama Kategori</label>
          <input type="text" id="name" name="name" placeholder="Contoh: AI, IoT, Web" required>
        </div>
        <div class="modal-confirm-actions">
          <button type="button" class="btn btn-sm" id="categoryCancelBtn">Batal</button>
          <button type="submit" class="btn btn-sm btn-primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Konfirmasi Hapus -->
<div class="modal-overlay" id="deleteModalOverlay">
  <div class="modal-box modal-box-confirm">
    <button type="button" class="modal-close" id="deleteModalCloseBtn">&times;</button>
    <div class="modal-body">
      <div class="modal-warn-icon">&#9888;</div>
      <h2>Hapus Kategori?</h2>
      <p class="modal-desc" id="deleteModalDesc"></p>
      <form id="deleteCategoryForm" method="POST" action="">
        <div class="modal-confirm-actions">
          <button type="button" class="btn btn-sm" id="deleteCancelBtn">Batal</button>
          <button type="submit" class="btn btn-sm btn-danger-solid">Ya, Hapus</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // ===== MODAL TAMBAH / EDIT =====
    const categoryOverlay = document.getElementById('categoryModalOverlay');
    const categoryForm = document.getElementById('categoryForm');
    const categoryTitle = document.getElementById('categoryModalTitle');
    const nameInput = document.getElementById('name');

    function openCategoryModal(mode, id, name) {
      if (mode === 'edit') {
        categoryTitle.textContent = 'Edit Kategori';
        categoryForm.setAttribute('action', '/admin/categories/' + id + '/update');
        nameInput.value = name || '';
      } else {
        categoryTitle.textContent = 'Tambah Kategori';
        categoryForm.setAttribute('action', '/admin/categories');
        nameInput.value = '';
      }
      categoryOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          categoryOverlay.classList.add('is-visible');
        });
      });
      nameInput.focus();
    }

    function closeCategoryModal() {
      categoryOverlay.classList.remove('is-visible');
      document.body.style.overflow = '';
      setTimeout(function () {
        categoryOverlay.classList.remove('active');
      }, 250);
    }

    document.getElementById('btnAddCategory').addEventListener('click', function () {
      openCategoryModal('add');
    });

    document.querySelectorAll('.js-edit-category').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openCategoryModal('edit', btn.dataset.id, btn.dataset.name);
      });
    });

    document.getElementById('categoryModalCloseBtn').addEventListener('click', closeCategoryModal);
    document.getElementById('categoryCancelBtn').addEventListener('click', closeCategoryModal);
    categoryOverlay.addEventListener('click', function (e) {
      if (e.target === categoryOverlay) closeCategoryModal();
    });

    // ===== MODAL HAPUS =====
    const deleteOverlay = document.getElementById('deleteModalOverlay');
    const deleteForm = document.getElementById('deleteCategoryForm');
    const deleteDesc = document.getElementById('deleteModalDesc');

    function openDeleteModal(action, name) {
      deleteForm.setAttribute('action', action);
      deleteDesc.textContent = 'Kategori "' + name + '" akan dihapus. Project yang memakainya akan jadi tanpa kategori.';
      deleteOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          deleteOverlay.classList.add('is-visible');
        });
      });
    }

    function closeDeleteModal() {
      deleteOverlay.classList.remove('is-visible');
      document.body.style.overflow = '';
      setTimeout(function () {
        deleteOverlay.classList.remove('active');
      }, 250);
    }

    document.querySelectorAll('.js-delete-category').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openDeleteModal(btn.dataset.action, btn.dataset.name);
      });
    });

    document.getElementById('deleteModalCloseBtn').addEventListener('click', closeDeleteModal);
    document.getElementById('deleteCancelBtn').addEventListener('click', closeDeleteModal);
    deleteOverlay.addEventListener('click', function (e) {
      if (e.target === deleteOverlay) closeDeleteModal();
    });

    // ===== ESC UNTUK TUTUP MODAL AKTIF =====
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeCategoryModal();
        closeDeleteModal();
      }
    });
  });
</script>

</body>
</html>
