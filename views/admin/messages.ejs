<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Messages — Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/message.css">
</head>
<body>

<div class="shell">

  <%- include('../partials/admin-sidebar', { active: 'messages' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <p class="eyebrow">Messages</p>
        <h1>Pesan masuk</h1>
        <p class="topbar-sub">Dari form kontak di halaman portfolio.</p>
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="filter-tabs">
      <a href="/admin/messages?filter=all"
         class="filter-tab <%= currentFilter === 'all' ? 'active' : '' %>">
         Semua
      </a>
      <a href="/admin/messages?filter=unread"
         class="filter-tab <%= currentFilter === 'unread' ? 'active' : '' %>">
         Belum dibaca
         <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
           <span class="count-badge"><%= unreadCount %></span>
         <% } %>
      </a>
      <a href="/admin/messages?filter=read"
         class="filter-tab <%= currentFilter === 'read' ? 'active' : '' %>">
         Sudah dibaca
      </a>
    </div>

    <div class="message-list">
      <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
        <% messages.forEach(function(msg) { %>
        <div class="message-card <%= msg.isRead ? '' : 'is-unread' %>" data-id="<%= msg.id %>" data-read="<%= msg.isRead %>">

            <div class="message-head">
              <div class="message-meta">
                <% if (!msg.isRead) { %>
                  <span class="badge-unread">Baru</span>
                <% } %>
                <span class="message-name"><%= msg.name %></span>
                <span class="message-email mono"><%= msg.email %></span>
                <% if (msg.phone) { %>
                  <span class="message-phone mono">📱 <%= msg.phone %></span>
                <% } %>
              </div>
              <span class="message-date mono"><%= msg.createdAt %></span>
            </div>

            <% if (msg.subject) { %>
              <p class="message-subject"><%= msg.subject %></p>
            <% } %>

            <p class="message-body"><%= msg.message %></p>

            <div class="message-actions">
              <a href="mailto:<%= msg.email %>?subject=<%= encodeURIComponent('Re: ' + (msg.subject || 'Pesan dari portfolio')) %>" class="btn-ghost">Balas</a>
              <form action="/admin/messages/<%= msg.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Hapus pesan ini?');">
                <button type="submit" class="btn-ghost btn-danger">Hapus</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <% if (currentFilter === 'unread') { %>
            Semua pesan sudah dibaca.
          <% } else { %>
            Belum ada pesan yang masuk.
          <% } %>
        </div>
      <% } %>
    </div>
  </main>

</div>

<script>
  // Klik card (bukan tombol/link di dalamnya) → tandai sudah dibaca
  document.querySelectorAll('.message-card.is-unread').forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('a, button, form')) return; // jangan trigger kalau klik aksi

      const id = card.dataset.id;

      fetch('/admin/messages/' + id + '/read', { method: 'POST' })
        .then(function (res) {
          if (res.ok) {
            card.classList.remove('is-unread');
            const badge = card.querySelector('.badge-unread');
            if (badge) badge.remove();
          }
        })
        .catch(function (err) {
          console.error('Gagal update status baca:', err);
        });
    });
  });
</script>

</body>
</html>