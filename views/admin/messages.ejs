<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Messages — Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

<div class="shell">

  <%- include('../partials/admin-sidebar', { active: 'messages' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <p class="eyebrow">Messages</p>
        <h1>Pesan masuk</h1>
        <p class="topbar-sub">Dari form kontak di halaman portfolio.</p>
      </div>
    </div>

    <div class="message-list">
      <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
        <% messages.forEach(function(msg) { %>
          <div class="message-card <%= msg.isRead ? '' : 'is-unread' %>">
            <div class="message-head">
              <div>
                <span class="message-name"><%= msg.name %></span>
                <span class="message-email mono"><%= msg.email %></span>
              </div>
              <span class="message-date mono"><%= msg.createdAt %></span>
            </div>
            <p class="message-body"><%= msg.message %></p>
            <div class="message-actions">
              <a href="mailto:<%= msg.email %>" class="btn-ghost">Balas</a>
              <form action="/admin/messages/<%= msg.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Hapus pesan ini?');">
                <button type="submit" class="btn-ghost btn-danger">Hapus</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">Belum ada pesan yang masuk.</div>
      <% } %>
    </div>
  </main>

</div>

</body>
</html>