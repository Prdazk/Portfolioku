<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">

  <div class="login-card">

    <!-- KIRI: ilustrasi -->
    <div class="card-left">
      <div class="illustration-wrap">
        <span class="shape shape-square"></span>
        <span class="shape shape-triangle"></span>
        <span class="shape shape-circle-sm"></span>
        <span class="shape shape-dot"></span>
        <div class="avatar-circle">
          <div class="avatar-frame">
            <img src="/css/images/Profil.png" alt="Foto Admin" class="avatar-photo">
          </div>
        </div>
      </div>
    </div>

    <!-- KANAN: form -->
    <div class="card-right">

      <% if (error) { %>
        <p class="error-msg"><%= error %></p>
      <% } %>

      <h1 class="login-title"><center>Silakan Login</center></h1>

      <form action="/admin/login" method="POST" class="login-form">
        <div class="input-group">
          <span class="input-icon">✉</span>
          <input type="text" id="email" name="email" placeholder="Email" required>
        </div>

        <div class="input-group">
          <span class="input-icon">🔒</span>
          <input type="password" id="password" name="password" placeholder="Password" required>
          <span class="toggle-password" id="togglePassword">👁</span>
        </div>

        <button type="submit" class="login-btn">Login</button>
      </form>

    <a href="/" class="forgot-link">&larr; Kembali ke <span>Beranda</span></a>
    </div>

  </div>

  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    togglePassword.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      togglePassword.style.opacity = isPassword ? '1' : '0.6';
    });
  </script>

</body>
</html>