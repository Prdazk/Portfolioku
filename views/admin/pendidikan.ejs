<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kelola Technologies</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/categories.css">
</head>
<body>

<div class="shell">

  <%- include('../partials/admin-sidebar', { active: 'technologies' }) %>

  <main class="main">
    <div class="topbar">
      <div>
        <p class="eyebrow">Kelola Konten</p>
        <h1>Technologies</h1>
        <p class="topbar-sub"><%= technologies.length %> teknologi tersedia untuk portfolio kamu.</p>
      </div>
      <button type="button" class="btn btn-primary" id="btnAddTechnology">+ Tambah Teknologi</button>
    </div>

    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <% if (technologies.length === 0) { %>
      <div class="empty-state">
        <p>Belum ada teknologi. Klik "Tambah Teknologi" untuk mulai menambahkan.</p>
      </div>
    <% } else { %>
      <div class="category-grid">
        <% technologies.forEach(function(tech) { %>
          <div class="category-card">
            <div class="category-info">
              <h3><%= tech.name %></h3>
              <p class="category-count"><%= tech.project_count || 0 %> project menggunakan teknologi ini</p>
            </div>

            <div class="category-actions">
              <button type="button"
                      class="btn btn-sm btn-icon js-edit-technology"
                      title="Edit"
                      aria-label="Edit"
                      data-id="<%= tech.id %>"
                      data-name="<%= tech.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                </svg>
              </button>

              <button type="button"
                      class="btn btn-sm btn-icon btn-danger js-delete-technology"
                      title="Hapus"
                      aria-label="Hapus"
                      data-action="/admin/technologies/<%= tech.id %>/delete"
                      data-name="<%= tech.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                </svg>
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

</div>

<!-- Modal Tambah / Edit Technology -->
<div class="modal-overlay" id="technologyModalOverlay">
  <div class="modal-box modal-box-confirm">
    <button type="button" class="modal-close" id="technologyModalCloseBtn">&times;</button>
    <div class="modal-body">
      <h2 id="technologyModalTitle">Tambah Teknologi</h2>
      <form id="technologyForm" method="POST" action="/admin/technologies">
        <div class="form-group">
          <label for="name">Nama Teknologi</label>
          <input type="text" id="name" name="name" placeholder="Contoh: React, Node.js, Python" required>
        </div>
        <div class="modal-confirm-actions">
          <button type="button" class="btn btn-sm" id="technologyCancelBtn">Batal</button>
          <button type="submit" class="btn btn-sm btn-primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Konfirmasi Hapus -->
<div class="modal-overlay" id="deleteModalOverlay">
  <div class="modal-box modal-box-confirm">
    <button type="button" class="modal-close" id="deleteModalCloseBtn">&times;</button>
    <div class="modal-body">
      <div class="modal-warn-icon">&#9888;</div>
      <h2>Hapus Teknologi?</h2>
      <p class="modal-desc" id="deleteModalDesc"></p>
      <form id="deleteTechnologyForm" method="POST" action="">
        <div class="modal-confirm-actions">
          <button type="button" class="btn btn-sm" id="deleteCancelBtn">Batal</button>
          <button type="submit" class="btn btn-sm btn-danger-solid">Ya, Hapus</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // ===== MODAL TAMBAH / EDIT =====
    const technologyOverlay = document.getElementById('technologyModalOverlay');
    const technologyForm = document.getElementById('technologyForm');
    const technologyTitle = document.getElementById('technologyModalTitle');
    const nameInput = document.getElementById('name');

    function openTechnologyModal(mode, id, name) {
      if (mode === 'edit') {
        technologyTitle.textContent = 'Edit Teknologi';
        technologyForm.setAttribute('action', '/admin/technologies/' + id + '/update');
        nameInput.value = name || '';
      } else {
        technologyTitle.textContent = 'Tambah Teknologi';
        technologyForm.setAttribute('action', '/admin/technologies');
        nameInput.value = '';
      }
      technologyOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          technologyOverlay.classList.add('is-visible');
        });
      });
      nameInput.focus();
    }

    function closeTechnologyModal() {
      technologyOverlay.classList.remove('is-visible');
      document.body.style.overflow = '';
      setTimeout(function () {
        technologyOverlay.classList.remove('active');
      }, 250);
    }

    document.getElementById('btnAddTechnology').addEventListener('click', function () {
      openTechnologyModal('add');
    });

    document.querySelectorAll('.js-edit-technology').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openTechnologyModal('edit', btn.dataset.id, btn.dataset.name);
      });
    });

    document.getElementById('technologyModalCloseBtn').addEventListener('click', closeTechnologyModal);
    document.getElementById('technologyCancelBtn').addEventListener('click', closeTechnologyModal);
    technologyOverlay.addEventListener('click', function (e) {
      if (e.target === technologyOverlay) closeTechnologyModal();
    });

    // ===== MODAL HAPUS =====
    const deleteOverlay = document.getElementById('deleteModalOverlay');
    const deleteForm = document.getElementById('deleteTechnologyForm');
    const deleteDesc = document.getElementById('deleteModalDesc');

    function openDeleteModal(action, name) {
      deleteForm.setAttribute('action', action);
      deleteDesc.textContent = 'Teknologi "' + name + '" akan dihapus. Project yang memakainya akan jadi tanpa teknologi ini.';
      deleteOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          deleteOverlay.classList.add('is-visible');
        });
      });
    }

    function closeDeleteModal() {
      deleteOverlay.classList.remove('is-visible');
      document.body.style.overflow = '';
      setTimeout(function () {
        deleteOverlay.classList.remove('active');
      }, 250);
    }

    document.querySelectorAll('.js-delete-technology').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openDeleteModal(btn.dataset.action, btn.dataset.name);
      });
    });

    document.getElementById('deleteModalCloseBtn').addEventListener('click', closeDeleteModal);
    document.getElementById('deleteCancelBtn').addEventListener('click', closeDeleteModal);
    deleteOverlay.addEventListener('click', function (e) {
      if (e.target === deleteOverlay) closeDeleteModal();
    });

    // ===== ESC UNTUK TUTUP MODAL AKTIF =====
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeTechnologyModal();
        closeDeleteModal();
      }
    });
  });
</script>

</body>
</html>
